approach:-

class Solution {
  public:
   void dfs(int node, vector<vector<int>>& adj, vector<int> & vis){
       vis[node]=1;
       for(auto it:adj[node]){
           if(!vis[it]){
               dfs(it,adj,vis);
           }
       }
   }
    int countConnected(int V, vector<vector<int>>& edges) {
        vector<vector<int>>adj(V);
        for(auto &e:edges){
            adj[e[0]].push_back(e[1]);
            adj[e[1]].push_back(e[0]);
        }
        vector<int>vis(V,0);
        int ans=0;
        for(int i=0;i<V;i++){
            if(!vis[i]){
                ans++;
                dfs(i,adj,vis);
            }
        }
        return ans;
    }
};