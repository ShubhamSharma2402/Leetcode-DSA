bfs traversal:-

class Solution {
  public:
    vector<int> bfs(vector<vector<int>> &adj) {
      int n=adj.size();
      int vis[n]={0};
      vis[0]=1;
      queue<int>q;
      q.push(0);
      vector<int>bfs;
      while(!q.empty()){
          int node=q.front();
          q.pop();
          bfs.push_back(node);
          for(auto it: adj[node]){
              if(!vis[it]){
                  vis[it]=1;
                  q.push(it);
              }
          }
      }
      return bfs;
    }
};


dfs traversal:-

class Solution {
  public:
  void dfs(int node,vector<vector<int>>& adj, int vis[],vector<int>&ls){
      vis[node]=1;
      ls.push_back(node);
      for(auto it: adj[node]){
          if(!vis[it]){
              dfs(it,adj,vis,ls);
          }
      }
  }
    vector<int> dfs(vector<vector<int>>& adj) {
        int n=adj.size();
     int vis[n]={0};
     int start=0;
     vector<int>ls;
     dfs(start,adj,vis,ls);
     return ls;
    }
};
