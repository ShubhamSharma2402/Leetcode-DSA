leetcode:- 286. Rotting walls and gates


ques:-

You are given an m × n grid representing rooms:

-1 → a wall or obstacle
0 → a gate
INF → an empty room

Your task is to fill each empty room with the distance to its nearest gate.
Distance is measured by moving up, down, left, or right.

For example:

Input:
INF  -1   0   INF
INF INF  INF  -1
INF  -1  INF  -1
0   -1   INF  INF

Output:
3   -1   0    1
2    2   1   -1
1   -1   2   -1
0   -1   3    4

approach:-


class Solution {
  public:
    void wallsAndGates(vector<vector<int>>& rooms) {
        int n=rooms.size();
        int m=rooms[0].size();
        queue<pair<int,int>>q;
        
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(rooms[i][j]==0){
                    q.push({i,j});
                }
            }
        }
        vector<pair<int,int>>dir={{1,0},{-1,0},{0,1},{0,-1}};
        while(!q.empty()){
            int size=q.size();
            while(size--){
                auto[r,c]=q.front();
                q.pop();
                
                for(auto[dr,dc]:dir){
                    int nr=r+dr;
                    int nc=c+dc;
                    
                    if(nr>=0 && nc>=0 && nr<n && nc<m && rooms[nr][nc]==INT_MAX){
                        rooms[nr][nc]=rooms[r][c]+1;
                        q.push({nr,nc});
                    }
                }
            }
        }
    }
};