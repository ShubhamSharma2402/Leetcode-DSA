class Solution {
public:
    vector<int> solve(int n,
                      vector<int>& parent,
                      vector<int>& C) {

        vector<vector<int>> children(n + 1);
        vector<int> compChildCount(n + 1, 0);
        vector<int> activeChildCount(n + 1, 0);
        vector<bool> alive(n + 1, true);

        int root = -1;

        // Build tree
        for (int i = 1; i <= n; i++) {
            if (parent[i] == -1) {
                root = i;
            } else {
                children[parent[i]].push_back(i);
            }
        }

        // Initialize counts
        for (int i = 1; i <= n; i++) {
            activeChildCount[i] = children[i].size();

            for (int ch : children[i]) {
                if (C[ch] == 1) {
                    compChildCount[i]++;
                }
            }
        }

        // min-heap for smallest ID first
        priority_queue<int, vector<int>, greater<int>> pq;

        for (int i = 1; i <= n; i++) {
            if (i != root &&
                C[i] == 0 &&
                compChildCount[i] == 0) {
                pq.push(i);
            }
        }

        vector<int> result;

        while (!pq.empty()) {
            int u = pq.top();
            pq.pop();

            if (!alive[u]) continue;

            if (u == root) continue;

            if (!(C[u] == 0 && compChildCount[u] == 0)) continue;

            alive[u] = false;
            result.push_back(u);

            int p = parent[u];

            if (p != -1 && alive[p]) {

                // remove u from parent's children logically
                activeChildCount[p]--;

                if (C[u] == 1) {
                    compChildCount[p]--;
                }

                // check if parent becomes removable
                if (p != root &&
                    C[p] == 0 &&
                    compChildCount[p] == 0 &&
                    alive[p]) {
                    pq.push(p);
                }
            }

            // update parent dependencies (no tree rewiring!)
            for (int v : children[u]) {
                if (!alive[v]) continue;

                parent[v] = p;

                if (p != -1) {
                    children[p].push_back(v);
                    activeChildCount[p]++;

                    if (C[v] == 1) {
                        compChildCount[p]++;
                    }
                }
            }
        }

        if (result.empty()) return {-1};

        return result;
    }
};