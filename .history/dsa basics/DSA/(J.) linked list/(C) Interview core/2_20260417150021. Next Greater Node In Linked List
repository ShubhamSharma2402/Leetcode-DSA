leetcode:-1019. Next Greater Node In Linked List

example:- Input: head = [2,7,4,3,5]
Output: [7,0,5,5,0]


approach:-

class Solution {
public:
    vector<int> nextLargerNodes(ListNode* head) {
        vector<int>v1;
        while(head!=NULL){
            v1.push_back(head->val);
            head=head->next;
        }
        int n=v1.size();
        vector<int>ans(n,0);
        stack<int>st;
        for(int i=0;i<n;i++){
            while(!st.empty() && v1[i]>v1[st.top()]){
                ans[st.top()]=v1[i];
                st.pop();
            }
            st.push(i);
        }
        return ans;
    }
};
