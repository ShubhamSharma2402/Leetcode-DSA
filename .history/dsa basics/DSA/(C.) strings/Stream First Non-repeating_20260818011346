gfg:-Stream First Non-repeating

approach:-1


class Solution {
  public:
    string firstNonRepeating(string &s) {
        unordered_map<char,int>mpp;
        queue<int>q;
        string result="";
        for(int i=0;i<s.size();i++){
            mpp[s[i]]++;
            q.push(s[i]);
            while(!q.empty() && mpp[q.front()]>1 ){
                q.pop();
            }
            if(q.empty()){
                result.push_back('#');
            }
            else{
                result.push_back(q.front());
            }
        }
        return result;
    }
};


