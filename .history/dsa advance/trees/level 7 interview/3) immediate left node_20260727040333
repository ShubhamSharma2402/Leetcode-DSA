TreeNode* findLeftNode(TreeNode* root, int x) {
    if (!root) return NULL;

    queue<TreeNode*> q;
    q.push(root);

    while (!q.empty()) {
        int size = q.size();
        TreeNode* prev = NULL;  // track left neighbor

        for (int i = 0; i < size; i++) {
            TreeNode* node = q.front();
            q.pop();

            if (node->val == x) {
                return prev;   // immediate left
            }

            prev = node;

            if (node->left) q.push(node->left);
            if (node->right) q.push(node->right);
        }
    }

    return NULL;
}