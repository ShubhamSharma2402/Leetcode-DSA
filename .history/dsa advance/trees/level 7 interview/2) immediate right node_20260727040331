ques:- Immediate Right Node (Same Level)

👉 Given a value x, return the node that is just to the right of it in the same level

Example:
        1
       / \
      2   3
     / \   \
    4   5   6

If x = 2 → answer = 3
If x = 5 → answer = 6
If x = 6 → answer = NULL


approach:-

TreeNode* findRightNode(TreeNode* root, int x) {
    if (!root) return NULL;

    queue<TreeNode*> q;
    q.push(root);

    while (!q.empty()) {
        int size = q.size();

        for (int i = 0; i < size; i++) {
            TreeNode* node = q.front();
            q.pop();

            if (node->val == x) {
                // if not last node in level
                if (i < size - 1) {
                    return q.front();
                } else {
                    return NULL;
                }
            }

            if (node->left) q.push(node->left);
            if (node->right) q.push(node->right);
        }
    }

    return NULL;
}