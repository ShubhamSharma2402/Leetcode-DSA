In a large city, buildings are arranged in a grid with n rows and m columns. Each building in this grid has a specific building type represented by an integer from 1 to 100,000. City planners want to analyze the distance between all buildings of the same type to better understand the distribution of building clusters.

The Manhattan distance between two buildings located at (r1, c1) and (r2, c2) is the total number of horizontal and vertical steps required to reach one from the other. The task is to calculate the sum of the Manhattan distances between each pair of buildings of the same type for every unique building type in the grid.

Input

The first line contains two integers n and m (1 ≤ n, m, and n m ≤100,000)-the number of rows and columns in the grid.

The next n lines each contain m integers representing the types of buildings in the corresponding row. Each building type is an integer between 1 and 100,000.

Output

Output a single integer the sum of the Manhattan distances between each pair of buildings of the same type.




code:-


#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    long long calc(vector<int> &v) {
        sort(v.begin(), v.end());

        long long pref = 0;
        long long ans = 0;

        for (int i = 0; i < (int)v.size(); i++) {
            ans += 1LL * v[i] * i - pref;
            pref += v[i];
        }

        return ans;
    }

    long long solve(int n, int m, vector<vector<int>> &a) {
        unordered_map<int, vector<int>> rows, cols;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                int val = a[i][j];
                rows[val].push_back(i);
                cols[val].push_back(j);
            }
        }

        long long ans = 0;

        for (auto &it : rows) {
            int val = it.first;
            ans += calc(rows[val]);
            ans += calc(cols[val]);
        }

        return ans;
    }
};